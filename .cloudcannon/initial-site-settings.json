{
  "ssg": "astro",
  "mode": "hosted",
  "build": {
    "hugoVersion": "0.157.0",
    "rubyVersion": "3.4.8",
    "nodeVersion": "22",
    "denoVersion": "2.7.1",
    "build_command": "npm run build:no-library",
    "output_path": "dist",
    "install_command": "npm install",
    "preserved_paths": "node_modules,.astro,node_modules/",
    "preserveOutput": true,
    "includeGit": true,
    "manually_configure_urls": true
  }
}