---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Page from "@layouts/Page.astro";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post: CollectionEntry<"blog">) => {
    const slug = post.id?.replace(/\.mdx?$/, "") || post.slug;

    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await render(post);

const date = new Date(post.data.pubDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Page title={post.data.title} description={post.data.description} image={post.data.image}>
  <CustomSection maxContentWidth="md" paddingHorizontal="lg" paddingVertical="2xl">
    <p class="blog-post-date">{date}</p>
    <Heading level="h1" size="xl" text={post.data.title} editable={false} />
    {post.data.author && <p class="blog-post-author">By {post.data.author}</p>}

    {post.data.image && (
      <Image
        source={post.data.image}
        alt={post.data.title}
        aspectRatio="landscape"
        rounded={true}
        editable={false}
      />
    )}

    <div class="blog-post-content">
      <Content />
    </div>

    <a class="blog-post-back" href="/blog/">&larr; Back to News</a>
  </CustomSection>
</Page>

<style lang="pcss" is:global>
  @layer page-sections {
    .blog-post-date {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      margin-top: 0;
    }

    .blog-post-author {
      color: var(--color-text-muted);
      margin-top: 0;
    }

    .blog-post-content {
      margin-top: var(--spacing-xl);

      img {
        border-radius: var(--radius-md);
        width: 100%;
      }
    }

    .blog-post-back {
      color: var(--color-link);
      display: inline-block;
      font-weight: var(--font-weight-semibold);
      margin-top: var(--spacing-2xl);
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }
</style>
