---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Grid from "@wrappers/grid/Grid.astro";
import GridItem from "@wrappers/grid/GridItem.astro";
import eventsData from "@data/events.json";

const {
  eyebrow = "",
  heading = "",
  colorScheme = "inherit",
  backgroundColor,
  backgroundImage,
  paddingVertical = "4xl",
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

type EventEntry = {
  name: string;
  region?: string;
  location?: string;
  date: string;
  time?: string;
};

const events: EventEntry[] = (eventsData as { events: EventEntry[] }).events || [];
const sorted = [...events].sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
---

<CustomSection
  class:list={["events-section", className]}
  maxContentWidth="lg"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  backgroundImage={backgroundImage}
  {...htmlAttributes}
>
  {eyebrow && <p class="events-section-eyebrow">{eyebrow}</p>}
  {heading && <Heading level="h2" size="default" alignX="center" text={heading} />}

  <Grid gap="md" layout="center" minItemWidth="240" maxItemWidth="340" style="margin-top: var(--spacing-xl);">
    {
      sorted.map((event) => {
        const dateStr = new Date(event.date).toLocaleDateString("en-US", {
          weekday: "long",
          month: "long",
          day: "numeric",
        });

        return (
          <GridItem>
            <div class="event-card">
              <p class="event-date">{dateStr}</p>
              <p class="event-name">{event.name}</p>
              {event.location && <p class="event-location">{event.location}</p>}
              {event.time && <p class="event-time">{event.time}</p>}
            </div>
          </GridItem>
        );
      })
    }
  </Grid>
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .events-section {
      text-align: center;

      .events-section-eyebrow {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.06em;
        margin: 0 0 var(--spacing-xs);
        text-transform: uppercase;
      }

      .event-card {
        background: var(--color-bg-surface);
        border-radius: var(--radius-md);
        height: 100%;
        padding: var(--spacing-lg);
        text-align: start;
      }

      .event-date {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        margin: 0 0 var(--spacing-xs);
        text-transform: uppercase;
      }

      .event-name {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        margin: 0 0 var(--spacing-xs);
      }

      .event-location,
      .event-time {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        margin: 0;
      }
    }
  }
</style>
